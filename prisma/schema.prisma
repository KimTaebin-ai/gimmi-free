generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // 연결 URL은 prisma.config.ts에서 관리 (Prisma 7)
}

// ---------- Auth.js (NextAuth v5) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  timezone      String    @default("Asia/Seoul")
  settings      Json?

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  tags           Tag[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  calendarSync   CalendarSyncState?
  routines       WorkoutRoutine[]
  workouts       Workout[]
  exercises      Exercise[]
  bodyMetrics    BodyMetric[]
  foods          Food[]
  meals          Meal[]
  growthSummaries GrowthSummary[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Tasks ----------

model Project {
  id        String  @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  sortOrder Int     @default(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Tag {
  id     String  @id @default(cuid())
  userId String
  name   String
  color  String?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  @@unique([userId, name])
}

enum TaskStatus {
  todo
  done
}

model Task {
  id            String     @id @default(cuid())
  userId        String
  projectId     String?
  parentId      String?
  title         String
  note          String?
  priority      Int        @default(0) // 0 none, 1 low, 2 medium, 3 high
  status        TaskStatus @default(todo)
  startAt       DateTime?
  dueAt         DateTime?
  allDay        Boolean    @default(true)
  rrule         String?
  completedAt   DateTime?
  sortOrder     Int        @default(0)
  googleEventId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]    @relation("Subtasks")
  tags     TaskTag[]
  entries  TaskEntry[]

  @@index([userId, status, dueAt])
  @@index([userId, projectId])
}

/// 태스크에 남기는 기록의 종류.
/// 수업·토크·세미나처럼 "듣고 배운" 태스크는 스크립트와 느낀 점을 따로 남긴다.
enum EntryKind {
  note // 메모
  script // 수업/발표 스크립트, 강의 내용
  reflection // 느낀 점, 배운 점
  link // 참고 자료
}

model TaskEntry {
  id        String    @id @default(cuid())
  taskId    String
  kind      EntryKind @default(note)
  title     String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// 성장 요약 캐시. "이전에 할 수 없던 걸 할 수 있게 됐는가"를 정리한 결과.
/// 매번 LLM을 호출하지 않도록 저장해 두고, 새 기록이 생기면 다시 만든다.
model GrowthSummary {
  id          String   @id @default(cuid())
  userId      String
  /// 요약이 다룬 기간
  periodStart DateTime
  periodEnd   DateTime
  /// 구조화된 결과(capabilities, inProgress, suggestions)
  content     Json
  /// 근거가 된 완료 태스크 수 — 새 기록이 쌓였는지 판단용
  sourceCount Int      @default(0)
  model       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ---------- Calendar ----------

enum EventSource {
  google
  task
}

model CalendarEvent {
  id            String      @id @default(cuid())
  userId        String
  googleEventId String
  calendarId    String      @default("primary")
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean     @default(false)
  location      String?
  htmlLink      String?
  source        EventSource @default(google)
  lastSyncedAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, startAt])
}

/// Google Calendar 증분 동기화 상태(syncToken). 사용자당 1행.
model CalendarSyncState {
  userId         String   @id
  calendarId     String   @default("primary")
  syncToken      String?
  lastSyncedAt   DateTime?
  lastError      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Fitness ----------

/// 부위별 볼륨 집계를 위해 종목을 분류한다.
enum MuscleGroup {
  chest
  back
  shoulders
  legs
  arms
  core
  cardio
  other
}

/// 사용자별 종목 사전. Workout/RoutineExercise는 이름(문자열)으로 기록하고
/// 부위 정보가 필요할 때 이름으로 조인한다(종목을 지워도 기록은 남도록).
model Exercise {
  id          String      @id @default(cuid())
  userId      String
  name        String
  muscleGroup MuscleGroup @default(other)
  isFavorite  Boolean     @default(false)
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, muscleGroup])
}

model WorkoutRoutine {
  id     String  @id @default(cuid())
  userId String
  name   String
  note   String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  workouts  Workout[]

  @@index([userId])
}

model RoutineExercise {
  id           String @id @default(cuid())
  routineId    String
  exerciseName String
  targetSets   Int
  targetReps   Int
  order        Int    @default(0)

  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  routineId String?
  note      String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine WorkoutRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  sets    WorkoutSet[]

  @@index([userId, date])
}

model WorkoutSet {
  id           String @id @default(cuid())
  workoutId    String
  exerciseName String
  /// 세션 안에서 종목이 놓인 순서(같은 종목의 세트는 같은 값)
  exerciseOrder Int   @default(0)
  setNo        Int
  reps         Int
  weightKg     Float

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId, exerciseOrder, setNo])
}

model BodyMetric {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  weightKg         Float?
  skeletalMuscleKg Float?
  bodyFatPct       Float?
  note             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------- Diet ----------

model Food {
  id             String  @id @default(cuid())
  userId         String
  name           String
  kcalPer100g    Float?
  proteinPer100g Float?
  carbPer100g    Float?
  fatPer100g     Float?
  isFavorite     Boolean @default(false)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItems MealItem[]

  @@index([userId])
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model Meal {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  type   MealType

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@unique([userId, date, type])
}

model MealItem {
  id       String  @id @default(cuid())
  mealId   String
  foodId   String?
  name     String
  amountG  Float?
  kcal     Float   @default(0)
  proteinG Float   @default(0)
  carbG    Float   @default(0)
  fatG     Float   @default(0)

  meal Meal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)
}
