generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // 연결 URL은 prisma.config.ts에서 관리 (Prisma 7)
}

// ---------- Auth.js (NextAuth v5) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  timezone      String    @default("Asia/Seoul")
  settings      Json?

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  tags           Tag[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  calendarSync   CalendarSyncState?
  routines       WorkoutRoutine[]
  workouts       Workout[]
  exercises      Exercise[]
  bodyMetrics    BodyMetric[]
  foods          Food[]
  meals          Meal[]
  growthSummaries GrowthSummary[]
  entries         TaskEntry[]
  blogPosts       BlogPost[]
  docChunks       DocChunk[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Tasks ----------

model Project {
  id        String  @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  sortOrder Int     @default(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Tag {
  id     String  @id @default(cuid())
  userId String
  name   String
  color  String?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  @@unique([userId, name])
}

enum TaskStatus {
  todo
  done
}

model Task {
  id            String     @id @default(cuid())
  userId        String
  projectId     String?
  parentId      String?
  title         String
  note          String?
  priority      Int        @default(0) // 0 none, 1 low, 2 medium, 3 high
  status        TaskStatus @default(todo)
  startAt       DateTime?
  dueAt         DateTime?
  allDay        Boolean    @default(true)
  rrule         String?
  completedAt   DateTime?
  sortOrder     Int        @default(0)
  googleEventId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]    @relation("Subtasks")
  tags     TaskTag[]
  entries  TaskEntry[]

  @@index([userId, status, dueAt])
  @@index([userId, projectId])
}

/// 태스크에 남기는 기록의 종류.
/// 수업·토크·세미나처럼 "듣고 배운" 태스크는 스크립트와 느낀 점을 따로 남긴다.
enum EntryKind {
  note // 메모
  script // 수업/발표 스크립트, 강의 내용
  reflection // 느낀 점, 배운 점
  link // 참고 자료
}

/// 기록은 태스크에도, Google 일정에도 붙는다(정확히 한쪽에만).
model TaskEntry {
  id        String    @id @default(cuid())
  kind      EntryKind @default(note)
  title     String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 태스크에 붙은 기록
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Google 일정에 붙은 기록.
  /// 로컬 CalendarEvent 행이 아니라 (userId, googleEventId)에 매단다 —
  /// 동기화 창을 벗어나 캐시가 정리돼도 사용자가 쓴 메모는 사라지면 안 되기 때문.
  userId        String?
  googleEventId String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, googleEventId, createdAt])
}

/// 성장 요약 캐시. "이전에 할 수 없던 걸 할 수 있게 됐는가"를 정리한 결과.
/// 매번 LLM을 호출하지 않도록 저장해 두고, 새 기록이 생기면 다시 만든다.
model GrowthSummary {
  id          String   @id @default(cuid())
  userId      String
  /// 요약이 다룬 기간
  periodStart DateTime
  periodEnd   DateTime
  /// 구조화된 결과(capabilities, inProgress, suggestions)
  content     Json
  /// 근거가 된 완료 태스크 수 — 새 기록이 쌓였는지 판단용
  sourceCount Int      @default(0)
  model       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ---------- Calendar ----------

enum EventSource {
  google
  task
}

model CalendarEvent {
  id            String      @id @default(cuid())
  userId        String
  googleEventId String
  calendarId    String      @default("primary")
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean     @default(false)
  location      String?
  htmlLink      String?
  source        EventSource @default(google)
  lastSyncedAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, startAt])
}

/// Google Calendar 증분 동기화 상태(syncToken). 사용자당 1행.
model CalendarSyncState {
  userId         String   @id
  calendarId     String   @default("primary")
  syncToken      String?
  lastSyncedAt   DateTime?
  lastError      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Blog (네이버 블로그 불러오기) ----------

enum BlogSource {
  /// 모바일 블로그 목록 API 크롤링(현재 경로)
  crawl
  /// 네이버 RSS. 서버가 빈 피드를 주게 되어 더는 쓰지 않는다
  rss
  search
}

/// 네이버 블로그에서 불러온 내 글. 목록은 모바일 목록 API, 본문은 모바일 글 페이지에서 받는다.
/// 본문은 네이버 HTML이 아니라 우리 블록 배열로 환원해 저장한다(naver/post-body.ts).
model BlogPost {
  id           String     @id @default(cuid())
  userId       String
  blogId       String
  /// 글 고유 번호(URL 마지막 숫자 세그먼트). 중복 판별 키.
  logNo        String
  title        String
  url          String
  summary      String?
  thumbnailUrl String?
  category     String?
  tags         String[]   @default([])
  publishedAt  DateTime
  source       BlogSource @default(crawl)
  fetchedAt    DateTime   @default(now())

  /// 본문 평문. 앱 안에서 읽기·검색·RAG 색인이 모두 이걸 쓴다.
  content       String?
  /// 본문을 우리가 아는 블록(문단/이미지/인용/링크)으로 환원한 것. 리더가 이걸 그린다.
  /// 네이버 마크업을 그대로 심지 않는 이유는 XSS와 테마 때문(post-body.ts 참고).
  contentBlocks Json?
  /// 본문을 마지막으로 받아온 시각. null이면 아직 못 받아왔다는 뜻.
  bodyFetchedAt DateTime?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocChunk[]

  @@unique([userId, logNo])
  @@index([userId, publishedAt])
}

/// RAG 검색 단위. 지금은 블로그 본문만 색인한다.
///
/// sourceId에 BlogPost FK가 걸려 있어 글을 지우면 청크도 함께 사라진다. 그 대신
/// DocSource를 blog 밖으로 넓히려면(태스크·기록 색인) 이 FK부터 손봐야 한다.
///
/// title/url/occurredAt은 BlogPost에서 베껴 둔다 — 검색은 raw SQL(pgvector)로 도는데
/// 매번 조인하지 않고 바로 프롬프트에 실을 수 있어야 해서다.
model DocChunk {
  id         String    @id @default(cuid())
  userId     String
  source     DocSource @default(blog)
  /// BlogPost.id
  sourceId   String
  chunkIndex Int

  /// 임베딩에 넣은 텍스트 그대로. 검색 결과로 프롬프트에 실리는 것도 이것.
  text       String
  title      String
  url        String
  occurredAt DateTime

  /// pgvector. Prisma가 다루지 못하는 타입이라 읽기/쓰기는 $queryRaw로 한다.
  embedding  Unsupported("vector(1024)")?
  /// 어떤 모델로 임베딩했는지 — 모델을 바꾸면 이 값으로 재색인 대상을 고른다.
  embedModel String
  createdAt  DateTime  @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BlogPost? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceId, chunkIndex])
  @@index([userId, occurredAt])
}

enum DocSource {
  blog
}

// ---------- Fitness ----------

/// 부위별 볼륨 집계를 위해 종목을 분류한다.
enum MuscleGroup {
  chest
  back
  shoulders
  legs
  arms
  core
  cardio
  other
}

/// 사용자별 종목 사전. Workout/RoutineExercise는 이름(문자열)으로 기록하고
/// 부위 정보가 필요할 때 이름으로 조인한다(종목을 지워도 기록은 남도록).
model Exercise {
  id          String      @id @default(cuid())
  userId      String
  name        String
  muscleGroup MuscleGroup @default(other)
  isFavorite  Boolean     @default(false)
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, muscleGroup])
}

model WorkoutRoutine {
  id     String  @id @default(cuid())
  userId String
  name   String
  note   String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  workouts  Workout[]

  @@index([userId])
}

model RoutineExercise {
  id           String @id @default(cuid())
  routineId    String
  exerciseName String
  targetSets   Int
  targetReps   Int
  order        Int    @default(0)

  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  routineId String?
  note      String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine WorkoutRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  sets    WorkoutSet[]

  @@index([userId, date])
}

model WorkoutSet {
  id           String @id @default(cuid())
  workoutId    String
  exerciseName String
  /// 세션 안에서 종목이 놓인 순서(같은 종목의 세트는 같은 값)
  exerciseOrder Int   @default(0)
  setNo        Int
  reps         Int
  weightKg     Float

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId, exerciseOrder, setNo])
}

model BodyMetric {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  weightKg         Float?
  skeletalMuscleKg Float?
  bodyFatPct       Float?
  note             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------- Diet ----------

model Food {
  id             String  @id @default(cuid())
  userId         String
  name           String
  kcalPer100g    Float?
  proteinPer100g Float?
  carbPer100g    Float?
  fatPer100g     Float?
  isFavorite     Boolean @default(false)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItems MealItem[]

  @@index([userId])
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model Meal {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  type   MealType

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@unique([userId, date, type])
}

model MealItem {
  id       String  @id @default(cuid())
  mealId   String
  foodId   String?
  name     String
  amountG  Float?
  kcal     Float   @default(0)
  proteinG Float   @default(0)
  carbG    Float   @default(0)
  fatG     Float   @default(0)

  meal Meal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)
}
