# Postgres 연결 문자열 (로컬: docker compose up -d 후 아래 값 그대로 사용 가능)
# 배포 시 Supabase/Neon 등 매니지드 Postgres URL로 교체
DATABASE_URL="postgresql://lifehub:lifehub@localhost:5432/lifehub"

# (Supabase 등 pooler 사용 시) 마이그레이션용 직접/세션 연결. 로컬 Docker에선 DATABASE_URL과 동일하게.
DIRECT_URL="postgresql://lifehub:lifehub@localhost:5432/lifehub"

# `npx auth secret` 으로 생성
AUTH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (+ 배포 URL)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 로그인 허용 이메일(콤마 구분). 이 목록에 없는 계정은 로그인 거부됨.
ALLOWED_EMAILS="you@gmail.com"

# 성장 요약(홈 화면)에 필요. https://console.anthropic.com 에서 발급.
# 없으면 앱은 정상 동작하고 홈 화면만 안내 문구를 보여준다.
ANTHROPIC_API_KEY=""

# Vercel Cron 보호용 시크릿(선택). 설정하면 /api/cron/* 가 Bearer 검증을 요구한다.
# Vercel에 같은 이름으로 등록하면 Cron 요청에 자동으로 Authorization 헤더가 붙는다.
CRON_SECRET=""

# 네이버 블로그 불러오기 — 내 블로그 아이디(blog.naver.com/{여기})
# 모바일 블로그 목록 API를 읽으므로 인증은 필요 없다(RSS는 네이버가 빈 피드를 줘서 폐기).
NAVER_BLOG_ID="ansiaos"

# (선택) 네이버 검색 API — 지금은 쓰지 않는다(목록 API가 전체 글을 준다).
# 키워드 검색 기반이라 전량 수집은 보장되지 않는다. 하루 25,000건 제한.
NAVER_SEARCH_CLIENT_ID=""
NAVER_SEARCH_CLIENT_SECRET=""
